# Laxorq Reception — environment (all optional; can also be set in the Settings UI)
PORT=4100
HOST=0.0.0.0

# Protects the admin API + dashboard when the server is tunnelled/deployed.
# Leave blank for local-only use.
ADMIN_KEY=

# Anthropic key for the AI brain. Can also be set in Settings (stored in the DB).
ANTHROPIC_API_KEY=

# Conversation model (quality) + cheap model (classification). Defaults shown.
CHAT_MODEL=claude-sonnet-4-6
FAST_MODEL=claude-haiku-4-5-20251001
